{
  "expo": {
    "name": "NusaWeather",
    "slug": "nusaweather",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nusaweather",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1628"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nusaweather.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "NusaWeather perlu akses lokasi untuk cuaca di sekitarmu."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundColor": "#0A1628"
      },
      "package": "com.nusaweather.app",
      "permissions": ["ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION"]
    },
    "plugins": [
      "expo-router",
      ["expo-location", {
        "locationAlwaysAndWhenInUsePermission": "NusaWeather perlu akses lokasi."
      }]
    ],
    "experiments": { "typedRoutes": true },
    "extra": { "eas": { "projectId": "your-eas-project-id" } }
  }
}